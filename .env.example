# Supabase Free: one project for PostgreSQL, Google login, and private photos.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server secret only; never prefix with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
SUPABASE_PHOTO_BUCKET=profile-photos
# Supabase Connect > Transaction pooler (port 6543), with TLS.
DATABASE_URL=
# Direct or session-pooler connection for migrations.
DIRECT_DATABASE_URL=
CLIST_API_KEY=
RESEND_API_KEY=
RESEND_FROM="Contest Manager <reminders@notifications.aarav.site>"
RESEND_WEBHOOK_SECRET=
# Same secret in deployment and Supabase Vault; generated locally already.
CRON_SECRET=
APP_URL=https://contest-manager.vercel.app

# Server-only comma-separated Supabase Auth IDs allowed to view /admin. Empty denies everyone.
ADMIN_AUTH_USER_IDS=

# Optional, server-only: enable deduplicated operational alerts (unset sends none).
OPERATIONS_ALERT_EMAIL=
# Local backup tool only: 32 random bytes as 64 hex characters. Store separately off-site.
BACKUP_ENCRYPTION_KEY=
